{
  "expo": {
    "name": "QuickMart",
    "slug": "quickmart-app",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "android": {
      "package": "com.quickmart.app",
      "adaptiveIcon": {
